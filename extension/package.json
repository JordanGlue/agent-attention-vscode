{
  "name": "agent-attention",
  "displayName": "Agent Attention",
  "description": "Dramatic, terminal-aware completion alerts for Codex CLI and Claude Code in VS Code.",
  "version": "0.2.0",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentAttention.showUnread",
        "title": "Agent Attention: Show Waiting Terminals"
      },
      {
        "command": "agentAttention.clearAll",
        "title": "Agent Attention: Clear All Alerts"
      }
    ]
  }
}
